---
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import ProjectPreviewCard from '@components/ProjectPreviewCard.astro';
import InventoryDashboardPreview from '@components/InventoryDashboardPreview.astro';
import FreightDashboardPreview from '@components/FreightDashboardPreview.astro';
import ExperienceTimeline from '@components/ExperienceTimeline.astro';
import { meta, hero, about, education, contact, contactSection } from '@content/site';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const headshot = images['../../content/images/' + about.headshot]?.default;

// Icon strokes inherit color from the wrapping element's `text-slate`, so they
// pick up the dark-mode value automatically rather than a hardcoded hex.
const iconAttrs = {
  width: 15,
  height: 15,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': true as const,
};
---

<Base path="/">
  {/* ------------------------------------------------------------------ Hero */}
  <section id="about" class="hero-shell shell pt-10 pb-10 md:pt-14 md:pb-12">
    <div class="flex flex-wrap items-start gap-x-10 gap-y-6">
      <div class="hero-copy min-w-0 basis-full sm:max-w-none sm:flex-1 sm:basis-[30rem]">
        <p class="eyebrow mb-3">{hero.eyebrow}</p>
        <h1 class="font-display text-hero font-semibold leading-[1.08] text-ink">
          {hero.headline}
        </h1>
        <p class="measure mt-4 text-lede leading-snug text-ink-soft">{hero.paragraph}</p>
      </div>
      <div class="w-32 shrink-0 sm:w-40 md:w-44">
        {
          headshot && (
            <Image
              src={headshot}
              alt={about.headshotAlt}
              width={389}
              height={389}
              class="block aspect-[4/5] w-full rounded-sm object-cover object-[50%_20%]"
              loading="eager"
            />
          )
        }
      </div>
    </div>

    {/* Two calm rows of two, not one dense four-column matrix. Capabilities and Tools
        wrap naturally; Education and Location each lead with an anchor line rather
        than running on as a single inline sentence. */}
    <dl class="hero-meta mt-10 grid gap-x-12 gap-y-7 sm:max-w-none sm:grid-cols-2 lg:gap-x-16">
      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <path d="M12 3 3 7.5l9 4.5 9-4.5L12 3Z" />
            <path d="m3 12.5 9 4.5 9-4.5" />
            <path d="m3 17 9 4.5 9-4.5" />
          </svg>
          Capabilities
        </dt>
        <dd class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">
          {hero.capabilities.join(' · ')}
        </dd>
      </div>

      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <ellipse cx="12" cy="5.5" rx="8" ry="3" />
            <path d="M4 5.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
            <path d="M4 11.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
          </svg>
          Tools
        </dt>
        <dd class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">
          {
            hero.tools.map((tool, index) => (
              <>
                {index > 0 && ' · '}
                <strong class="font-semibold text-ink">{tool.label}:</strong> {tool.items}
              </>
            ))
          }
        </dd>
      </div>

      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <path d="M2 8.5 12 4l10 4.5-10 4.5L2 8.5Z" />
            <path d="M6 10.6v4.6c0 1.5 2.7 2.8 6 2.8s6-1.3 6-2.8v-4.6" />
            <path d="M21 9v5" />
          </svg>
          Education
        </dt>
        <dd class="mt-1.5">
          <span class="block text-[15px] font-medium text-ink">{education.institution}</span>
          {
            education.degrees.map((d) => (
              <span class="mt-0.5 block text-[15px] leading-relaxed text-ink-soft">
                {d.degree}, {d.year}
              </span>
            ))
          }
        </dd>
      </div>

      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <path d="M20 10.5c0 5.2-8 11-8 11s-8-5.8-8-11a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10.2" r="2.8" />
          </svg>
          Location
        </dt>
        <dd class="mt-1.5">
          <span class="block text-[15px] font-medium text-ink">{hero.basedIn}</span>
          <span class="mt-0.5 block text-[15px] leading-relaxed text-ink-soft">
            {hero.basedNote}
          </span>
        </dd>
      </div>
    </dl>
  </section>

  {/* ---------------------------------------------------------------- Projects */}
  <Section id="projects" heading="Projects" divided>
    <ul class="grid list-none gap-x-9 gap-y-12 lg:grid-cols-2">
      <li class="flex">
        <ProjectPreviewCard
          href="/work/inventory-forecasting-reorder-planning/"
          eyebrow="INVENTORY PLANNING"
          title="Demand Forecasting & Reorder Planning"
          built="Forecasted 24 SKUs and set safety stock and reorder levels from 18 months of demand."
          kpis={[
            { value: '24', label: 'SKUs' },
            { value: '18', label: 'Months' },
            { value: '$78.4K', label: 'Inventory value' },
            { value: '$43.7K', label: 'Suggested reorder' },
          ]}
        >
          <InventoryDashboardPreview />
        </ProjectPreviewCard>
      </li>
      <li class="flex">
        <ProjectPreviewCard
          href="/work/freight-spend-vendor-cost-review/"
          eyebrow="FREIGHT COST ANALYSIS"
          title="Freight Cost & Invoice Review"
          built="Reviewed 12 months of freight invoices, compared vendor costs and flagged lines that needed checking."
          kpis={[
            { value: '$695K', label: 'Reviewed spend' },
            { value: '421', label: 'Invoice lines' },
            { value: '60', label: 'Lines to review' },
            { value: '$137.6K', label: 'Spend to review' },
          ]}
        >
          <FreightDashboardPreview />
        </ProjectPreviewCard>
      </li>
    </ul>

  </Section>

  {/* -------------------------------------------------------------- Experience */}
  <Section id="experience" heading="Career" density="tight" divided>
    <ExperienceTimeline />
  </Section>

  {/* ----------------------------------------------------------- Get in touch */}
  {/* The page's restrained closing move: contact actions followed by a quiet
      footer row, with no separate homepage footer in Base. */}
  <Section id="contact" divided>
    <div class="max-w-[40rem]">
      <h2 class="font-display text-section text-ink">{contactSection.heading}</h2>
      <p class="mt-3 text-base leading-relaxed text-ink-soft">{contactSection.supporting}</p>

      <div class="mt-6 grid gap-3">
        <a class="contact-primary" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a class="contact-link" href={contact.linkedin} rel="me">LinkedIn</a>
          <a class="contact-link" href={meta.resumePath}>Résumé</a>
        </div>
      </div>
    </div>

    <footer class="mt-10 flex flex-col items-start gap-3 border-t border-rule pt-5 text-[13px] sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <p class="text-ink-mute">{`© ${new Date().getFullYear()} ${meta.name}`}</p>
      <nav aria-label="Footer">
        <ul class="flex list-none flex-wrap items-center gap-x-4 gap-y-2">
          <li>
            <a class="footer-icon" href={contact.linkedin} rel="me" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.32 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.1 20.45H3.54V9H7.1v11.45Z" />
              </svg>
            </a>
          </li>
          <li>
            <a class="footer-icon" href={contact.github} aria-label="GitHub">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.99 10.99 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
              </svg>
            </a>
          </li>
          <li><a class="footer-link" href="#top">Back to top <span aria-hidden="true">↑</span></a></li>
        </ul>
      </nav>
    </footer>
  </Section>
</Base>

<style>
  /* Email is the primary action, so it carries more weight than the other two. */
  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 17px;
    font-weight: 500;
    color: var(--color-slate);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .contact-primary:hover {
    color: var(--color-slate-deep);
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 15px;
    color: var(--color-slate);
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--color-slate) 55%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .contact-link:hover {
    color: var(--color-slate-deep);
    text-decoration-color: currentColor;
  }
  .footer-link {
    color: var(--color-slate);
    text-decoration: none;
  }
  .footer-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    color: var(--color-slate);
  }
  .footer-icon:hover {
    color: var(--color-slate-deep);
  }
  .footer-link:hover {
    color: var(--color-slate-deep);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 639px) {
    .hero-shell {
      width: 100vw;
      max-width: 100vw;
    }
    .hero-copy,
    .hero-meta {
      width: calc(100vw - 3rem);
      max-width: calc(100vw - 3rem);
    }
  }
</style>
