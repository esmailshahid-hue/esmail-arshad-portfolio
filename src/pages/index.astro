---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import ProjectPreviewCard from '@components/ProjectPreviewCard.astro';
import InventoryDashboardPreview from '@components/InventoryDashboardPreview.astro';
import FreightDashboardPreview from '@components/FreightDashboardPreview.astro';
import ExperienceTimeline from '@components/ExperienceTimeline.astro';
import { meta, hero, about, education, contact, contactSection } from '@content/site';

const totalPublished = (await getCollection('work')).filter((w) => w.data.published).length;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const headshot = images['../../content/images/' + about.headshot]?.default;

// Icon strokes inherit color from the wrapping element's `text-slate`, so they
// pick up the dark-mode value automatically rather than a hardcoded hex.
const iconAttrs = {
  width: 15,
  height: 15,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': true as const,
};
---

<Base path="/">
  {/* ------------------------------------------------------------------ Hero */}
  <section class="shell pt-10 pb-10 md:pt-14 md:pb-12">
    <div class="flex flex-wrap items-start gap-x-10 gap-y-6">
      <div class="min-w-0 flex-1 basis-[30rem]">
        <h1 class="font-display text-hero font-semibold leading-[1.08] text-ink">
          {hero.greeting}
        </h1>
        <p class="measure mt-4 text-lede leading-snug text-ink-soft">{hero.paragraph}</p>
      </div>
      <div class="w-32 shrink-0 sm:w-40 md:w-44">
        {
          headshot && (
            <Image
              src={headshot}
              alt={about.headshotAlt}
              width={389}
              height={389}
              class="block aspect-[4/5] w-full rounded-sm object-cover object-[50%_20%]"
              loading="eager"
            />
          )
        }
      </div>
    </div>

    {/* Two calm rows of two, not one dense four-column matrix. Core and Systems
        wrap naturally; Education and Based each lead with an anchor line rather
        than running on as a single inline sentence. */}
    <dl class="mt-10 grid gap-x-12 gap-y-7 sm:grid-cols-2 lg:gap-x-16">
      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <path d="M12 3 3 7.5l9 4.5 9-4.5L12 3Z" />
            <path d="m3 12.5 9 4.5 9-4.5" />
            <path d="m3 17 9 4.5 9-4.5" />
          </svg>
          Core
        </dt>
        <dd class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">{hero.core}</dd>
      </div>

      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <ellipse cx="12" cy="5.5" rx="8" ry="3" />
            <path d="M4 5.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
            <path d="M4 11.5v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
          </svg>
          Systems
        </dt>
        <dd class="mt-1.5 text-[15px] leading-relaxed text-ink-soft">{hero.systems}</dd>
      </div>

      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <path d="M2 8.5 12 4l10 4.5-10 4.5L2 8.5Z" />
            <path d="M6 10.6v4.6c0 1.5 2.7 2.8 6 2.8s6-1.3 6-2.8v-4.6" />
            <path d="M21 9v5" />
          </svg>
          Education
        </dt>
        <dd class="mt-1.5">
          <span class="block text-[15px] font-medium text-ink">{education.institution}</span>
          {
            education.degrees.map((d) => (
              <span class="mt-0.5 block text-[15px] leading-relaxed text-ink-soft">
                {d.degree}, {d.year}
              </span>
            ))
          }
        </dd>
      </div>

      <div class="min-w-0">
        <dt class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
          <svg {...iconAttrs} class="shrink-0 text-slate">
            <path d="M20 10.5c0 5.2-8 11-8 11s-8-5.8-8-11a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10.2" r="2.8" />
          </svg>
          Based
        </dt>
        <dd class="mt-1.5">
          <span class="block text-[15px] font-medium text-ink">{hero.basedIn}</span>
          <span class="mt-0.5 block text-[15px] leading-relaxed text-ink-soft">
            {hero.basedNote}
          </span>
        </dd>
      </div>
    </dl>
  </section>

  {/* ---------------------------------------------------------------- Projects */}
  <Section id="projects" heading="Projects" divided>
    <ul class="grid list-none gap-x-9 gap-y-12 lg:grid-cols-2">
      <li class="flex">
        <ProjectPreviewCard
          href="/work/inventory-forecasting-reorder-planning/"
          eyebrow="Demand & inventory planning"
          title="Matching forecast methods to SKU demand behavior"
          built="Built an Excel planning model linking demand behaviour, safety stock and reorder decisions."
          kpis={[
            { value: '24', label: 'SKUs' },
            { value: '15', label: 'Stockout risk' },
            { value: '1', label: 'Excess stock' },
            { value: '$43.7K', label: 'Suggested reorder' },
          ]}
          methods={['Excel', 'Forecasting', 'Reorder planning']}
        >
          <InventoryDashboardPreview />
        </ProjectPreviewCard>
      </li>
      <li class="flex">
        <ProjectPreviewCard
          href="/work/freight-spend-vendor-cost-review/"
          eyebrow="Freight spend & vendor cost analysis"
          title="Turning freight spend into a review queue"
          built="Built an Excel spend model to normalize freight costs and surface review exceptions."
          kpis={[
            { value: '$695K', label: 'Reviewed spend' },
            { value: '421', label: 'Invoice lines' },
            { value: '60', label: 'Review flags' },
            { value: '$137.6K', label: 'Flagged spend' },
          ]}
          methods={['Excel', 'Spend analytics', 'Anomaly review']}
        >
          <FreightDashboardPreview />
        </ProjectPreviewCard>
      </li>
    </ul>

    <p class="mt-10">
      <a href="/work/" class="text-sm text-slate no-underline hover:underline">
        View all {totalPublished} projects <span aria-hidden="true">→</span>
      </a>
    </p>
  </Section>

  {/* -------------------------------------------------------------- Experience */}
  <Section id="experience" heading="Experience" density="tight" divided>
    <ExperienceTimeline />
  </Section>

  {/* ----------------------------------------------------------- Get in touch */}
  {/* The page's closing move, not a utility strip. The address is shown in full
      rather than hidden behind the word "Email", and the copyright is folded in
      here so no separate footer block follows. */}
  <Section id="contact" divided>
    <div class="flex flex-wrap items-start justify-between gap-x-14 gap-y-8">
      <div class="min-w-0 max-w-xl flex-1 basis-80">
        <h2 class="font-display text-section text-ink">{contactSection.heading}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-soft">{contactSection.supporting}</p>
      </div>

      <div class="grid shrink-0 gap-3">
        <a class="contact-primary" href={`mailto:${contact.email}`}>
          <svg {...iconAttrs} width="17" height="17" class="shrink-0 text-slate">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3.5 6.5 8.5 6 8.5-6" />
          </svg>
          {contact.email}
        </a>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a class="contact-link" href={contact.linkedin} rel="me">
            <svg {...iconAttrs} class="shrink-0 text-slate">
              <rect x="3" y="3" width="18" height="18" rx="2" />
              <path d="M7 10v7" />
              <path d="M7 7v.01" />
              <path d="M11 17v-4a2.5 2.5 0 0 1 5 0v4" />
              <path d="M11 10v7" />
            </svg>
            LinkedIn
          </a>
          <a class="contact-link" href={meta.resumePath}>
            <svg {...iconAttrs} class="shrink-0 text-slate">
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z" />
              <path d="M14 3v5h5" />
            </svg>
            Résumé (PDF)
          </a>
        </div>
      </div>
    </div>

    <p class="mt-12 border-t border-rule-soft pt-5 text-xs text-ink-mute">
      {`© ${new Date().getFullYear()} ${meta.name}`}
    </p>
  </Section>
</Base>

<style>
  /* Email is the primary action, so it carries more weight than the other two. */
  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 17px;
    font-weight: 500;
    color: var(--color-slate);
    text-decoration: none;
    border-bottom: 1px solid var(--color-slate);
    padding-bottom: 3px;
    transition: color 0.15s ease;
  }
  .contact-primary:hover {
    color: var(--color-slate-deep);
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 15px;
    color: var(--color-slate);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-slate) 40%, transparent);
    padding-bottom: 2px;
    transition: border-color 0.15s ease;
  }
  .contact-link:hover {
    border-bottom-color: var(--color-slate);
  }
</style>
