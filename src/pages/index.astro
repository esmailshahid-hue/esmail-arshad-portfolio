---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import Metric from '@components/Metric.astro';
import Tag from '@components/Tag.astro';
import WorkCard from '@components/WorkCard.astro';
import {
  meta,
  hero,
  companyStrip,
  proofLine,
  capabilities,
  systems,
  experience,
  about,
  education,
  contact,
} from '@content/site';

const work = await getCollection('work');
const byOrder = (a: (typeof work)[number], b: (typeof work)[number]) =>
  a.data.order - b.data.order;

const operating = work.filter((w) => w.data.type === 'operating-case-study').sort(byOrder);
const client = work.filter((w) => w.data.type === 'client-project').sort(byOrder);

// Resolve the headshot from content/images (§0.4 rule 6: nothing sourced elsewhere).
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const headshot = images[`../../content/images/${about.headshot}`]?.default;
---

<Base path="/">
  {/* ---------------------------------------------------------------- Hero */}
  <section class="shell pt-16 pb-14 md:pt-24 md:pb-20">
    <h1 class="text-hero font-display font-semibold leading-[1.02] text-ink">
      {meta.name}
    </h1>
    <p class="mt-5 font-display text-display text-slate">{meta.positioning}</p>
    <p class="measure mt-6 text-xl leading-snug text-ink md:text-2xl">
      {meta.proposition}
    </p>
    <p class="measure mt-6 text-base leading-relaxed text-ink-soft">
      {hero.supporting}
    </p>

    <p class="mt-8 max-w-2xl border-l-2 border-slate pl-4 text-sm leading-relaxed text-ink-soft">
      {hero.mobility}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="#work"
        class="rounded-sm bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-colors hover:bg-slate-deep"
      >
        Selected Work
      </a>
      <a
        href={meta.resumePath}
        class="rounded-sm border border-ink px-6 py-3 text-sm font-medium text-ink no-underline transition-colors hover:border-slate hover:text-slate"
      >
        Résumé
      </a>
      <span class="flex gap-6 text-sm">
        <a class="text-link" href={contact.linkedin} rel="me">LinkedIn</a>
        <a class="text-link" href={`mailto:${contact.email}`}>Email</a>
      </span>
    </div>
  </section>

  {/* -------------------------------------------------------- Company strip */}
  <section aria-label="Organizations worked with" class="border-y border-rule bg-paper-deep">
    <div class="shell py-6">
      <ul
        class="flex list-none flex-wrap items-center gap-x-8 gap-y-3 font-display text-lg text-ink-soft md:gap-x-14 md:text-xl"
      >
        {companyStrip.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  {/* ----------------------------------------------------------- Proof line */}
  <section class="shell py-14 md:py-16">
    <ul class="grid list-none gap-8 sm:grid-cols-3 sm:gap-10">
      {
        proofLine.map((p) => (
          <li>
            <Metric value={p.value} label={`${p.label} — ${p.org}`} kind="outcome" size="lg" />
          </li>
        ))
      }
    </ul>
  </section>

  {/* -------------------------------------------- Capabilities and Systems */}
  <Section
    id="capabilities"
    eyebrow="Capabilities"
    heading="What I work on"
    lede="Four areas of practice, each supported by the work below."
  >
    <div class="grid gap-10 md:grid-cols-2 md:gap-x-14 md:gap-y-12">
      {
        capabilities.map((group) => (
          <div class="border-t border-rule pt-5">
            <h3 class="font-display text-xl text-ink">{group.tag}</h3>
            <ul class="mt-4 flex list-none flex-wrap gap-x-2 gap-y-2 text-sm text-ink-soft">
              {group.skills.map((s, i) => (
                <li class="flex items-center gap-2">
                  {i > 0 && <span aria-hidden="true" class="text-rule">·</span>}
                  <span>{s}</span>
                </li>
              ))}
            </ul>
            <p class="mt-5 text-xs text-ink-mute">
              See:{' '}
              {work
                .filter((w) => w.data.capabilities.includes(group.tag))
                .map((w, i, arr) => (
                  <>
                    {w.data.published ? (
                      <a class="text-link-quiet" href={`/work/${w.id}/`}>
                        {w.data.organization}
                      </a>
                    ) : (
                      <span>{w.data.organization}</span>
                    )}
                    {i < arr.length - 1 ? ', ' : ''}
                  </>
                ))}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 border-t border-rule pt-8">
      <h3 class="eyebrow mb-6">Systems</h3>
      <dl class="grid gap-6 sm:grid-cols-2 md:gap-10">
        {
          systems.map((s) => (
            <div>
              <dt class="text-sm font-semibold text-ink">{s.group}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-ink-soft">{s.items.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  {/* --------------------------------------------------------- Selected work */}
  <Section
    id="work"
    eyebrow="Selected Work"
    heading="Operating decisions, and the analysis underneath them"
  >
    <div class="mb-12 grid gap-4 border-l-2 border-slate pl-5 md:max-w-3xl">
      <p class="text-[0.9375rem] leading-relaxed text-ink-soft">
        <strong class="font-semibold text-ink">Operating case studies</strong> prove business
        impact and judgment. They carry no screenshots — employer data cannot be shown.
      </p>
      <p class="text-[0.9375rem] leading-relaxed text-ink-soft">
        <strong class="font-semibold text-ink">Client projects</strong> prove analytical method.
        They carry the artifacts.
      </p>
    </div>

    <h3 class="eyebrow mb-8">Operating case studies</h3>
    <ul class="grid list-none gap-x-10 gap-y-12 md:grid-cols-2">
      {operating.map((entry) => <li class="flex"><WorkCard entry={entry} /></li>)}
    </ul>

    <h3 class="eyebrow mt-20 mb-8">Client analytics projects</h3>
    <ul class="grid list-none gap-x-10 gap-y-12 md:grid-cols-2">
      {client.map((entry) => <li class="flex"><WorkCard entry={entry} /></li>)}
    </ul>
  </Section>

  {/* ------------------------------------------------------------ Experience */}
  <Section id="experience" eyebrow="Experience" heading="Where the work happened">
    <ol class="list-none">
      {
        experience.map((role) => (
          <li class="grid gap-2 border-t border-rule-soft py-6 md:grid-cols-[1fr_auto] md:gap-8">
            <div>
              <h3 class="font-display text-xl text-ink">
                {role.company}
                <span class="text-ink-mute"> · </span>
                <span class="font-sans text-base font-medium text-ink-soft">
                  {role.displayTitle}
                </span>
              </h3>
              <p class="mt-1.5 text-[0.9375rem] italic text-ink-soft">{role.scope}</p>
              {'achievement' in role && role.achievement && (
                <p class="measure mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
                  {role.achievement}
                </p>
              )}
            </div>
            <p class="text-sm text-ink-mute md:text-right">
              {role.dates}
              <span class="mx-1.5 md:hidden">·</span>
              <span class="md:block">{role.location}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ----------------------------------------------------------------- About */}
  <Section id="about" eyebrow="About" heading="How I got here">
    <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-14">
      {
        headshot && (
          <Image
            src={headshot}
            alt={about.headshotAlt}
            width={180}
            height={180}
            class="h-32 w-32 rounded-sm object-cover md:h-44 md:w-44"
          />
        )
      }
      <div class="measure">
        {about.paragraphs.map((p) => (
          <p class="mb-4 text-lg leading-relaxed text-ink-soft last:mb-0">{p}</p>
        ))}
      </div>
    </div>
  </Section>

  {/* ---------------------------------------------- Education & Certification */}
  <Section id="education" eyebrow="Education" heading="Education & Certification">
    <div class="grid gap-10 md:grid-cols-2 md:gap-16">
      <div class="border-t border-rule pt-5">
        <h3 class="font-display text-xl text-ink">{education.institution}</h3>
        <p class="mt-1 text-sm text-ink-mute">{education.location}</p>
        <ul class="mt-5 grid list-none gap-4">
          {
            education.degrees.map((d) => (
              <li>
                <p class="text-[0.9375rem] font-medium text-ink">{d.degree}</p>
                <p class="mt-0.5 text-sm text-ink-soft">
                  {d.year}
                  {d.detail && <span> · {d.detail}</span>}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      {
        education.certifications.length > 0 && (
          <div class="border-t border-rule pt-5">
            <h3 class="font-display text-xl text-ink">Certification</h3>
            <ul class="mt-5 grid list-none gap-4">
              {education.certifications.map((c) => (
                <li>
                  <p class="text-[0.9375rem] font-medium text-ink">{c.name}</p>
                  {c.issuer && <p class="mt-0.5 text-sm text-ink-soft">{c.issuer}</p>}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Section>

  {/* --------------------------------------------------------------- Contact */}
  <Section id="contact" eyebrow="Contact" heading="Contact">
    <p class="measure text-lg text-ink-soft">{contact.intro}</p>
    <ul class="mt-8 flex list-none flex-wrap gap-x-10 gap-y-4 text-base">
      <li>
        <a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a>
      </li>
      <li>
        <a class="text-link" href={contact.linkedin} rel="me">{contact.linkedinLabel}</a>
      </li>
      <li>
        <a class="text-link" href={meta.resumePath}>Résumé (PDF)</a>
      </li>
      {
        contact.github && (
          <li>
            <a class="text-link" href={contact.github}>GitHub</a>
          </li>
        )
      }
    </ul>
  </Section>
</Base>

<style>
  .text-link {
    color: var(--color-slate);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .text-link:hover {
    color: var(--color-slate-deep);
  }
  .text-link-quiet {
    color: var(--color-ink-mute);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .text-link-quiet:hover {
    color: var(--color-slate);
  }
</style>
