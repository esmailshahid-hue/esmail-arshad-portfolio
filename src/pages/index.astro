---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import EmployerCard from '@components/EmployerCard.astro';
import ClientCard from '@components/ClientCard.astro';
import { meta, hero, experience, about, education, contact } from '@content/site';

const work = (await getCollection('work'))
  .filter((w) => w.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const employer = work.filter((w) => w.data.type === 'operating-case-study');
const client = work.filter((w) => w.data.type === 'client-project');

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const img = (file: string) => images[`../../content/images/${file}`]?.default;

const headshot = img(about.headshot);
const thumbOf = (entry: (typeof work)[number]) => {
  const primary = entry.data.images.find((i) => i.primary) ?? entry.data.images[0];
  return primary ? img(primary.file) : undefined;
};
---

<Base path="/">
  {/* ------------------------------------------------------------------ Hero */}
  <section class="shell pt-14 pb-12 md:pt-20 md:pb-16">
    <h1 class="max-w-4xl font-display text-hero font-semibold leading-[1.03] text-ink">
      {meta.positioning}
    </h1>

    <p class="measure mt-6 text-xl leading-snug text-ink md:text-2xl">
      {meta.proposition}
    </p>

    <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft">
      {hero.credential} {hero.context}
    </p>

    <p class="mt-7 max-w-2xl text-sm text-ink-soft">
      {hero.disciplines.join(' · ')}
    </p>
    <p class="mt-2 max-w-2xl text-sm text-ink-mute">
      {hero.systems.join(' · ')}
    </p>

    <p class="mt-7 text-sm text-ink-mute">{hero.mobility}</p>

    <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
      <a
        href="#work"
        class="rounded-sm bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline transition-colors hover:bg-slate-deep"
      >
        Selected Work
      </a>
      <a
        href={meta.resumePath}
        class="rounded-sm border border-ink px-5 py-2.5 text-sm font-medium text-ink no-underline transition-colors hover:border-slate hover:text-slate"
      >
        Résumé
      </a>
    </div>
  </section>

  {/* --------------------------------------------------------- Selected work */}
  <Section id="work" heading="Selected work" divided>
    <ul class="grid list-none gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {employer.map((entry) => <li class="flex"><EmployerCard entry={entry} /></li>)}
    </ul>

    <ul class="mt-16 grid list-none gap-x-10 gap-y-12 md:grid-cols-2">
      {
        client.map((entry) => (
          <li class="flex">
            <ClientCard entry={entry} thumb={thumbOf(entry)} />
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ------------------------------------------------------------ Experience */}
  <Section id="experience" heading="Experience" density="tight" divided>
    <ol class="list-none">
      {
        experience.map((role) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-x-5 border-t border-rule-soft py-3.5 sm:grid-cols-[7rem_1fr] md:grid-cols-[8rem_1fr_9rem]">
            <p class="text-sm text-ink-mute">{role.dates}</p>
            <div>
              <p class="text-[0.9375rem] font-medium text-ink">{role.company}</p>
              <p class="mt-0.5 text-sm text-ink-soft">
                {role.displayTitle} <span class="text-ink-mute">·</span> {role.scope}
              </p>
            </div>
            <p class="col-start-2 mt-1 text-sm text-ink-mute md:col-start-3 md:mt-0 md:text-right">
              {role.location}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ------------------------------------------- About / Education / Contact */}
  <Section id="about" density="tight" divided>
    <div class="grid gap-10 md:grid-cols-3 md:gap-14">
      <div class="md:col-span-2">
        <div class="flex items-start gap-5">
          {
            headshot && (
              <Image
                src={headshot}
                alt={about.headshotAlt}
                width={144}
                height={144}
                class="hidden h-18 w-18 shrink-0 rounded-sm object-cover sm:block"
              />
            )
          }
          <p class="text-base leading-relaxed text-ink-soft">{about.text}</p>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-1">
        <div id="education">
          <h2 class="text-sm font-semibold text-ink">Education</h2>
          <p class="mt-2 text-sm text-ink">{education.institution}</p>
          <ul class="mt-1 grid list-none gap-1">
            {
              education.degrees.map((d) => (
                <li class="text-sm text-ink-soft">
                  {d.degree}, {d.year}
                  {d.detail && <span class="text-ink-mute"> · {d.detail}</span>}
                </li>
              ))
            }
            {
              education.certifications.map((c) => (
                <li class="mt-2 text-sm text-ink-soft">
                  {c.name}
                  {c.issuer && <span class="text-ink-mute"> · {c.issuer}</span>}
                </li>
              ))
            }
          </ul>
        </div>

        <div id="contact">
          <h2 class="text-sm font-semibold text-ink">Contact</h2>
          <ul class="mt-2 grid list-none gap-1 text-sm">
            <li><a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li>
              <a class="text-link" href={contact.linkedin} rel="me">{contact.linkedinLabel}</a>
            </li>
            <li><a class="text-link" href={meta.resumePath}>Résumé (PDF)</a></li>
            {contact.github && <li><a class="text-link" href={contact.github}>GitHub</a></li>}
          </ul>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  .text-link {
    color: var(--color-slate);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .text-link:hover {
    color: var(--color-slate-deep);
  }
</style>
