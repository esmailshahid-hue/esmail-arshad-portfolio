---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import EmployerCard from '@components/EmployerCard.astro';
import ClientCard from '@components/ClientCard.astro';
import { meta, hero, experience, about, education, contact } from '@content/site';

// The homepage curates. Everything published lives on /work/.
const featured = (await getCollection('work'))
  .filter((w) => w.data.published && w.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const total = (await getCollection('work')).filter((w) => w.data.published).length;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const img = (file: string) => images[`../../content/images/${file}`]?.default;

const headshot = img(about.headshot);
const thumbOf = (entry: (typeof featured)[number]) => {
  const primary = entry.data.images.find((i) => i.primary) ?? entry.data.images[0];
  return primary ? img(primary.file) : undefined;
};

const [lead, ...rest] = featured;
---

<Base path="/">
  {/* ------------------------------------------------------------------ Hero */}
  <section class="shell pt-12 pb-14 md:pt-16 md:pb-20">
    <div
      class="grid items-start gap-x-16 gap-y-10 md:grid-cols-[minmax(0,1fr)_16rem] lg:gap-x-20"
    >
      <div>
        <h1 class="max-w-3xl font-display text-hero font-semibold leading-[1.06] text-ink">
          {hero.greeting}
        </h1>

        <p class="mt-7 max-w-2xl text-lede leading-snug text-ink-soft">{hero.intro}</p>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
          {hero.background}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href="#work"
            class="rounded-sm bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline transition-colors hover:bg-slate-deep"
          >
            View case studies
          </a>
          <a
            href={meta.resumePath}
            class="rounded-sm border border-ink px-5 py-2.5 text-sm font-medium text-ink no-underline transition-colors hover:border-slate hover:text-slate"
          >
            Résumé
          </a>
        </div>

        <p class="mt-7 text-sm text-ink-mute">{hero.mobility}</p>
      </div>

      {
        headshot && (
          <Image
            src={headshot}
            alt={about.headshotAlt}
            width={389}
            height={389}
            class="order-first w-40 rounded-sm object-cover sm:w-48 md:order-none md:w-full"
            loading="eager"
          />
        )
      }
    </div>
  </section>

  {/* -------------------------------------------------------- Case studies */}
  <Section id="work" divided>
    <p class="text-xs font-medium tracking-wide text-ink-mute uppercase">Case studies</p>
    <h2 class="mt-3 mb-9 font-display text-section text-ink md:mb-11">
      A few problems I’ve worked on
    </h2>

    <ul class="grid list-none gap-x-10 gap-y-11 md:grid-cols-2">
      <li class="flex md:col-span-2">
        <EmployerCard entry={lead} lead />
      </li>
      {
        rest.map((entry) => (
          <li class="flex">
            {entry.data.type === 'client-project' ? (
              <ClientCard entry={entry} thumb={thumbOf(entry)} />
            ) : (
              <EmployerCard entry={entry} />
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-11">
      <a href="/work/" class="text-sm text-slate no-underline hover:underline">
        View all {total} case studies <span aria-hidden="true">→</span>
      </a>
    </p>
  </Section>

  {/* --------------------------------------------------------------- About */}
  <Section id="about" heading="About" density="tight" divided>
    <div class="grid max-w-2xl gap-4">
      {about.paragraphs.map((para) => <p class="text-base leading-relaxed text-ink-soft">{para}</p>)}
    </div>
  </Section>

  {/* ---------------------------------------------------- Where I've worked */}
  <Section id="experience" heading="Where I’ve worked" density="tight" divided>
    <ol class="grid list-none gap-0">
      {
        experience.map((role) => (
          <li class="grid grid-cols-[6rem_1fr] gap-x-6 border-l border-rule py-3.5 pl-6 sm:grid-cols-[8rem_1fr]">
            <p class="text-sm text-ink-mute">{role.dates}</p>
            <div>
              <p class="text-[0.9375rem] font-medium text-ink">{role.company}</p>
              <p class="mt-0.5 text-sm text-ink-soft">{role.displayTitle}</p>
            </div>
          </li>
        ))
      }
    </ol>
    {/* Per-row locations made the timeline a résumé again, but US work history is
        real signal for someone seeking international roles. One line keeps it. */}
    <p class="mt-5 pl-6 text-sm text-ink-mute">Roles in the United States and Pakistan.</p>
  </Section>

  {/* ------------------------------------------------ Education and contact */}
  <Section density="tight" divided>
    <div class="grid gap-10 sm:grid-cols-2 md:gap-16">
      <div id="education">
        <h2 class="text-sm font-semibold text-ink">Education</h2>
        <p class="mt-2 text-sm text-ink">{education.institution}</p>
        <ul class="mt-1 grid list-none gap-1">
          {
            education.degrees.map((d) => (
              <li class="text-sm text-ink-soft">
                {d.degree}, {d.year}
                {d.detail && <span class="text-ink-mute"> · {d.detail}</span>}
              </li>
            ))
          }
        </ul>
      </div>

      <div id="contact">
        <h2 class="text-sm font-semibold text-ink">Contact</h2>
        <ul class="mt-2 grid list-none gap-1 text-sm">
          <li><a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li>
            <a class="text-link" href={contact.linkedin} rel="me">{contact.linkedinLabel}</a>
          </li>
          <li><a class="text-link" href={meta.resumePath}>Résumé (PDF)</a></li>
        </ul>
      </div>
    </div>
  </Section>
</Base>

<style>
  .text-link {
    color: var(--color-slate);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .text-link:hover {
    color: var(--color-slate-deep);
  }
</style>
