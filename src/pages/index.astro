---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import EmployerCard from '@components/EmployerCard.astro';
import ClientCard from '@components/ClientCard.astro';
import { meta, hero, experience, about, education, contact } from '@content/site';

const work = (await getCollection('work'))
  .filter((w) => w.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const employer = work.filter((w) => w.data.type === 'operating-case-study');
const client = work.filter((w) => w.data.type === 'client-project');

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);
const img = (file: string) => images[`../../content/images/${file}`]?.default;

const headshot = img(about.headshot);
const thumbOf = (entry: (typeof work)[number]) => {
  const primary = entry.data.images.find((i) => i.primary) ?? entry.data.images[0];
  return primary ? img(primary.file) : undefined;
};
---

<Base path="/">
  {/* ------------------------------------------------------------------ Hero */}
  <section class="shell pt-14 pb-12 md:pt-20 md:pb-16">
    <h1 class="max-w-4xl font-display text-hero font-semibold leading-[1.03] text-ink">
      {meta.positioning}
    </h1>

    {/* Statement at full width; the specifics fill the column beside it rather
        than stacking into a single grey wall below. */}
    <div class="mt-8 grid gap-x-16 gap-y-9 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)]">
      <div>
        <p class="text-lede leading-snug text-ink">{meta.proposition}</p>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
          {hero.credential} {hero.context}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a
            href="#work"
            class="rounded-sm bg-ink px-5 py-2.5 text-sm font-medium text-paper no-underline transition-colors hover:bg-slate-deep"
          >
            Selected Work
          </a>
          <a
            href={meta.resumePath}
            class="rounded-sm border border-ink px-5 py-2.5 text-sm font-medium text-ink no-underline transition-colors hover:border-slate hover:text-slate"
          >
            Résumé
          </a>
        </div>
      </div>

      <dl class="grid gap-5 self-start border-t border-rule pt-6 lg:mt-1.5">
        <div>
          <dt class="text-xs font-medium tracking-wide text-ink-mute uppercase">Focus</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">
            {hero.disciplines.join(' · ')}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium tracking-wide text-ink-mute uppercase">Systems</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">
            {hero.systems.join(' · ')}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium tracking-wide text-ink-mute uppercase">Based</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink-soft">{hero.mobility}</dd>
        </div>
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------- Selected work */}
  <Section id="work" heading="Selected work" divided>
    <ul class="grid list-none gap-x-10 gap-y-11 sm:grid-cols-2 lg:grid-cols-4">
      {
        employer.map((entry, i) => (
          <li class={`flex ${i === 0 ? 'lg:col-span-2' : ''}`}>
            <EmployerCard entry={entry} lead={i === 0} />
          </li>
        ))
      }
    </ul>

    <ul class="mt-16 grid list-none gap-x-10 gap-y-12 md:grid-cols-2">
      {
        client.map((entry) => (
          <li class="flex">
            <ClientCard entry={entry} thumb={thumbOf(entry)} />
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ------------------------------------------------------------ Experience */}
  <Section id="experience" heading="Experience" density="tight" divided>
    <ol class="list-none">
      {
        experience.map((role, i) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-x-5 py-3.5 sm:grid-cols-[7rem_1fr] md:grid-cols-[8rem_1fr_9rem]">
            <p class="text-sm text-ink-mute">{role.dates}</p>
            <div class="relative pl-6">
              {/* Rail: stops short at the last role so the line doesn't dangle. */}
              <span
                aria-hidden="true"
                class:list={[
                  'absolute left-[0.21875rem] top-3 w-px bg-rule',
                  i === experience.length - 1 ? 'h-0' : '-bottom-3.5',
                ]}
              />
              <span
                aria-hidden="true"
                class="absolute left-0 top-[0.3125rem] h-2 w-2 rounded-full border-2 border-slate bg-paper"
              />
              <p class="text-[0.9375rem] font-medium text-ink">{role.company}</p>
              <p class="mt-0.5 text-sm text-ink-soft">
                {role.displayTitle} <span class="text-ink-mute">·</span> {role.scope}
              </p>
            </div>
            <p class="col-start-2 mt-1 pl-6 text-sm text-ink-mute md:col-start-3 md:mt-0 md:pl-0 md:text-right">
              {role.location}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* ------------------------------------------- About / Education / Contact */}
  <Section id="about" density="tight" divided>
    <div class="grid gap-10 md:grid-cols-3 md:gap-14">
      <div class="md:col-span-2">
        <div class="flex items-start gap-5">
          {
            headshot && (
              <Image
                src={headshot}
                alt={about.headshotAlt}
                width={144}
                height={144}
                class="hidden h-18 w-18 shrink-0 rounded-sm object-cover sm:block"
              />
            )
          }
          <p class="text-base leading-relaxed text-ink-soft">{about.text}</p>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-1">
        <div id="education">
          <h2 class="text-sm font-semibold text-ink">Education</h2>
          <p class="mt-3 text-sm text-ink">{education.institution}</p>
          <ul class="mt-1 grid list-none gap-1">
            {
              education.degrees.map((d) => (
                <li class="text-sm text-ink-soft">
                  {d.degree}, {d.year}
                  {d.detail && <span class="text-ink-mute"> · {d.detail}</span>}
                </li>
              ))
            }
            {
              education.certifications.map((c) => (
                <li class="mt-2 text-sm text-ink-soft">
                  {c.name}
                  {c.issuer && <span class="text-ink-mute"> · {c.issuer}</span>}
                </li>
              ))
            }
          </ul>
        </div>

        <div id="contact">
          <h2 class="text-sm font-semibold text-ink">Contact</h2>
          <ul class="mt-3 grid list-none gap-3 text-sm">
            <li class="grid gap-0.5">
              <span class="text-xs text-ink-mute">Email</span>
              <a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a>
            </li>
            <li class="grid gap-0.5 border-t border-rule-soft pt-3">
              <span class="text-xs text-ink-mute">LinkedIn</span>
              <a class="text-link" href={contact.linkedin} rel="me">{contact.linkedinLabel}</a>
            </li>
            <li class="grid gap-0.5 border-t border-rule-soft pt-3">
              <span class="text-xs text-ink-mute">Résumé</span>
              <a class="text-link" href={meta.resumePath}>Download (PDF)</a>
            </li>
            {
              contact.github && (
                <li class="grid gap-0.5 border-t border-rule-soft pt-3">
                  <span class="text-xs text-ink-mute">GitHub</span>
                  <a class="text-link" href={contact.github}>
                    {contact.github.replace(/^https?:\/\//, '')}
                  </a>
                </li>
              )
            }
          </ul>
        </div>
      </div>
    </div>
  </Section>
</Base>

<style>
  .text-link {
    color: var(--color-slate);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .text-link:hover {
    color: var(--color-slate-deep);
  }
</style>
