---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import Section from '@components/Section.astro';
import EmployerCard from '@components/EmployerCard.astro';
import ClientCard from '@components/ClientCard.astro';
import { meta } from '@content/site';

// One combined archive, split by work type for context.
const work = (await getCollection('work'))
  .filter((w) => w.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const employer = work.filter((w) => w.data.type === 'operating-case-study');
const client = work.filter((w) => w.data.type === 'client-project');
---

<Base
  title={`Case Studies | ${meta.name}`}
  description="Selected case studies across supply chain planning, sourcing, logistics, operations and analytics, including sanitized client work."
  path="/work/"
>
  <section class="shell pt-10 pb-8 md:pt-14 md:pb-10">
    <a href="/" class="text-sm text-ink-mute no-underline hover:text-slate">
      <span aria-hidden="true">←</span> Home
    </a>
    <h1 class="mt-7 max-w-3xl font-display text-display text-ink">Case Studies</h1>
    <p class="measure mt-4 text-lg leading-relaxed text-ink-soft">
      Selected case studies from my work in planning, sourcing, logistics and operations, focused
      on the decisions behind the results.
    </p>
  </section>

  <Section heading="Career Highlights" density="tight" divided>
    <ul class="grid list-none gap-x-10 gap-y-9 sm:grid-cols-2 xl:grid-cols-3">
      {
        employer.map((entry) => (
          <li class="flex">
            <EmployerCard entry={entry} compact />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section heading="Client Projects" density="tight" divided>
    <ul class="grid list-none gap-x-10 gap-y-9 sm:grid-cols-2">
      {
        client.map((entry) => (
          <li class="flex">
            <ClientCard entry={entry} compact />
          </li>
        ))
      }
    </ul>
    <p class="mt-9 max-w-2xl text-sm leading-relaxed text-ink-mute">
      Client identities are withheld. Data and screenshots are sanitized for portfolio use.
    </p>
  </Section>
</Base>
