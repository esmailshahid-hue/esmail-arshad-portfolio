---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Metric from '@components/Metric.astro';
import Tag from '@components/Tag.astro';
import { meta } from '@content/site';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const work = await getCollection('work');
  // Only published pages get a route. Drafts carry unresolved TODOs and must
  // never reach the public site (§13 publication gate, §0.4 rule 3).
  return work
    .filter((entry) => entry.data.published)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props as Props;
const d = entry.data;
const { Content } = await render(entry);

const artifactImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);

const resolved = d.images
  .map((img) => ({
    ...img,
    src: artifactImages[`../../../content/images/${img.file}`]?.default,
  }))
  .filter((img) => img.src);

const isClient = d.type === 'client-project';
---

<Base
  title={`${d.title} | ${meta.name}`}
  description={d.summary}
  path={`/work/${entry.id}/`}
  type="article"
>
  <article>
    {/* ------------------------------------------------------------ Snapshot */}
    <header class="shell pt-12 pb-10 md:pt-16 md:pb-14">
      <a href="/#work" class="text-sm text-ink-mute no-underline hover:text-slate">
        <span aria-hidden="true">←</span> Selected Work
      </a>

      <p class="eyebrow mt-8 mb-4">
        {d.organization}
        {d.displayTitle && <span> · {d.displayTitle}</span>}
        <span> · {d.timeframe}</span>
      </p>

      <h1 class="max-w-4xl text-display font-display text-ink">{d.title}</h1>
      <p class="measure mt-5 text-lg leading-relaxed text-ink-soft">{d.summary}</p>

      <p class="mt-6 text-sm text-ink-mute">{d.roleFocus}</p>

      <ul class="mt-7 flex list-none flex-wrap gap-2">
        {d.capabilities.map((c) => <li><Tag label={c} href="/#capabilities" /></li>)}
      </ul>
    </header>

    {/* ------------------------------------------------- Snapshot metric band */}
    <div class="border-y border-rule bg-paper-deep">
      <div class="shell py-10">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <Metric
            value={d.headlineOutcome.value}
            label={d.headlineOutcome.label}
            kind={d.headlineOutcome.kind}
            size="md"
          />
          {
            d.supportingMetrics.map((m) => (
              <Metric value={m.value} label={m.label} kind={m.kind} size="sm" />
            ))
          }
        </div>

        {
          (d.scope.length > 0 || d.tools.length > 0) && (
            <dl class="mt-10 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2">
              {d.scope.length > 0 && (
                <div>
                  <dt class="eyebrow mb-2">Scope</dt>
                  <dd class="text-sm text-ink-soft">{d.scope.join(' · ')}</dd>
                </div>
              )}
              {d.tools.length > 0 && (
                <div>
                  <dt class="eyebrow mb-2">Tools</dt>
                  <dd class="text-sm text-ink-soft">{d.tools.join(' · ')}</dd>
                </div>
              )}
            </dl>
          )
        }
      </div>
    </div>

    {/* ---------------------------------------------------------------- Body */}
    <div class="shell py-14 md:py-20">
      <div class="grid gap-14 lg:grid-cols-[minmax(0,38rem)_1fr] lg:gap-16">
        <div class="prose-editorial min-w-0">
          <Content />
        </div>

        {/* ------------------------------------------------------- Artifacts */}
        {
          resolved.length > 0 && (
            <aside aria-labelledby="artifacts-heading" class="min-w-0 lg:pt-1">
              <h2 id="artifacts-heading" class="eyebrow mb-6">
                From the workbook
              </h2>
              <ul class="grid min-w-0 list-none gap-10">
                {resolved.map((img) => (
                  <li class="min-w-0">
                    <figure>
                      <div class="max-w-full overflow-x-auto border border-rule bg-white">
                        <Image
                          src={img.src!}
                          alt={img.alt}
                          widths={[640, 960, 1400]}
                          sizes="(min-width: 1024px) 40vw, 92vw"
                          class="h-auto w-full max-w-none min-w-[36rem]"
                          loading="lazy"
                        />
                      </div>
                      <figcaption class="mt-3 text-sm leading-relaxed text-ink-soft">
                        <span class="font-medium text-ink">{img.sheet}</span> — {img.caption}
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>

              {isClient && (
                <p class="mt-10 border-t border-rule pt-5 text-xs leading-relaxed text-ink-mute">
                  Anonymized client project. Delivered for a real client and shown as sanitized
                  excerpts; the client, platform and commercial terms are not identified. The
                  workbook is not distributed.
                </p>
              )}
            </aside>
          )
        }
      </div>
    </div>

    <div class="shell pb-8">
      <a href="/#work" class="text-sm text-slate no-underline hover:underline">
        <span aria-hidden="true">←</span> All work
      </a>
    </div>
  </article>
</Base>
