---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@layouts/Base.astro';
import Diagram from '@components/Diagram.astro';
import { meta } from '@content/site';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const work = await getCollection('work');
  // Only published pages get a route. Drafts carry unresolved TODOs and must
  // never reach the public site (§13 publication gate, §0.4 rule 3).
  return work
    .filter((entry) => entry.data.published)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

const { entry } = Astro.props as Props;
const d = entry.data;
const { Content } = await render(entry);

const artifactImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../../content/images/*.{jpg,jpeg,png}',
  { eager: true }
);

const resolved = d.images
  .map((img) => ({ ...img, src: artifactImages[`../../../content/images/${img.file}`]?.default }))
  .filter((img) => img.src);

const lead = resolved.find((i) => i.primary) ?? resolved[0];
const supporting = resolved.filter((i) => i !== lead);

const isClient = d.type === 'client-project';
---

<Base
  title={`${d.title} | ${meta.name}`}
  description={d.summary}
  path={`/work/${entry.id}/`}
  type="article"
>
  <article>
    {/* ------------------------------------------------------------- Summary */}
    <header class="shell pt-10 pb-8 md:pt-14 md:pb-10">
      <a href="/#work" class="text-sm text-ink-mute no-underline hover:text-slate">
        <span aria-hidden="true">←</span> Selected work
      </a>

      <p class="mt-7 text-sm font-medium text-ink">
        {d.organization}
        {d.displayTitle && <span class="text-ink-soft"> · {d.displayTitle}</span>}
        {isClient && <span class="text-ink-soft"> · {d.roleFocus}</span>}
        <span class="text-ink-mute"> · {d.timeframe}</span>
      </p>

      <h1 class="mt-3 max-w-3xl font-display text-display text-ink">{d.title}</h1>
      <p class="measure mt-4 text-lg leading-relaxed text-ink-soft">{d.summary}</p>

      {/* Tools sit quietly under the title — never their own section. */}
      {
        d.tools.length > 0 && (
          <p class="mt-4 text-sm text-ink-mute">{d.tools.join(' · ')}</p>
        )
      }

      {/* Three facts, one line each: the signal, the work, and what it came to.
          Nothing here is repeated in a large treatment further down the page. */}
      {
        d.atAGlance && (
          <dl class="mt-8 grid gap-x-10 gap-y-6 border-t border-rule pt-6 sm:grid-cols-3">
            {d.atAGlance.map((item) => (
              <div>
                <dt class="text-xs font-medium tracking-wide text-ink-mute uppercase">
                  {item.label}
                </dt>
                <dd class="mt-2">
                  <span class="font-display text-xl font-semibold text-ink">{item.value}</span>
                  <span class="mt-0.5 block text-sm leading-snug text-ink-soft">{item.note}</span>
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </header>

    {/* ------------------------------------------------------- Primary visual */}
    {
      d.diagram && (
        <div class="shell pb-10 md:pb-12">
          <Diagram {...d.diagram} />
        </div>
      )
    }

    {
      lead && (
        <div class="shell pb-10 md:pb-14">
          <figure>
            <div class="max-w-full overflow-x-auto border border-rule bg-white">
              <Image
                src={lead.src!}
                alt={lead.alt}
                widths={[720, 1100, 1600]}
                sizes="(min-width: 1280px) 76rem, 94vw"
                class="h-auto w-full max-w-none min-w-[44rem]"
                loading="eager"
              />
            </div>
            <figcaption class="mt-3 text-sm text-ink-mute">
              <span class="text-ink-soft">{lead.sheet}</span> — {lead.caption}
            </figcaption>
          </figure>
        </div>
      )
    }

    {/* ---------------------------------------------------------------- Body */}
    <div class="shell pb-12 md:pb-16">
      <div class="max-w-2xl">
        <div class="prose-editorial mt-8">
          <Content />
        </div>
      </div>

      {/* ------------------------------------------------ Supporting artifacts */}
      {
        supporting.length > 0 && (
          <div class="mt-14 border-t border-rule pt-10">
            <ul class="grid list-none gap-12">
              {supporting.map((img) => (
                <li class="min-w-0">
                  <figure>
                    <div class="max-w-full overflow-x-auto border border-rule bg-white">
                      <Image
                        src={img.src!}
                        alt={img.alt}
                        widths={[720, 1100, 1600]}
                        sizes="(min-width: 1280px) 76rem, 94vw"
                        class="h-auto w-full max-w-none min-w-[44rem]"
                        loading="lazy"
                      />
                    </div>
                    <figcaption class="mt-3 text-sm text-ink-mute">
                      <span class="text-ink-soft">{img.sheet}</span> — {img.caption}
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        isClient && (
          <p class="mt-12 max-w-2xl border-t border-rule pt-5 text-sm leading-relaxed text-ink-mute">
            Client identity omitted. The data and artifacts shown here have been sanitized for
            portfolio use, and the workbook itself is not distributed.
          </p>
        )
      }

      <p class="mt-12">
        <a href="/#work" class="text-sm text-slate no-underline hover:underline">
          <span aria-hidden="true">←</span> All work
        </a>
      </p>
    </div>
  </article>
</Base>
