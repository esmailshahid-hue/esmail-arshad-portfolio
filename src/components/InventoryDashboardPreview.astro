---
/** Verified in the sanitized workbook Dashboard risk-status counts. */
const positions = [
  { label: 'At/below reorder', percentage: 62.5 },
  { label: 'Balanced', percentage: 33.3 },
  { label: 'Excess', percentage: 4.2 },
] as const;
---

<div class="lg:mt-10">
  <p class="text-[12px] font-medium text-ink-soft">Inventory position</p>
  <div
    class="mt-2.5 flex h-4 overflow-hidden rounded-sm bg-rule-soft"
    role="img"
    aria-label="15 at or below reorder point, 8 balanced, and 1 excess across 24 SKUs"
  >
    <div class="bg-slate" style="width:62.5%" />
    <div class="bg-ink-mute/40" style="width:33.3%" />
    <div class="bg-rule" style="width:4.2%" />
  </div>
  <div class="mt-3 grid grid-cols-3 gap-2.5">
    {
      positions.map((position) => (
        <div class="min-w-0">
          <p class="text-[13px] font-semibold tabular-nums text-ink">{position.percentage.toFixed(1)}%</p>
          <p class="mt-0.5 text-[11.5px] leading-snug text-ink-mute">{position.label}</p>
        </div>
      ))
    }
  </div>
</div>
