---
/** Verified in the sanitized workbook Dashboard. */
const invoiceLines = 421;
const linesToReview = 60;
const reviewedSpend = 695475.29;
const spendToReview = 137615.04;

const coverage = [
  { label: 'of invoice lines', percentage: (linesToReview / invoiceLines) * 100 },
  { label: 'of spend', percentage: (spendToReview / reviewedSpend) * 100 },
] as const;

const reasons = [
  { label: 'Non-USD invoices', count: 29 },
  { label: 'Missing PO', count: 19 },
  { label: 'High-cost', count: 10 },
  { label: 'Possible duplicate', count: 4 },
] as const;
const maxReasonCount = Math.max(...reasons.map((reason) => reason.count));
---

<div class="grid gap-4">
  <div>
    <p class="text-[12px] font-medium text-ink-soft">Review coverage</p>
    <div class="mt-2.5 grid gap-2">
      {
        coverage.map((item) => (
          <div class="grid grid-cols-[6.5rem_minmax(0,1fr)_2.75rem] items-center gap-2.5">
            <p class="text-[12px] text-ink-soft">{item.label}</p>
            <div class="h-[8px] rounded-sm bg-rule-soft">
              <div class="h-[8px] rounded-sm bg-slate" style={`width:${item.percentage}%`} />
            </div>
            <p class="text-right text-[12.5px] font-semibold tabular-nums text-ink">
              {item.percentage.toFixed(1)}%
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div>
    <p class="text-[12px] font-medium text-ink-soft">Reasons for review</p>
    <p class="mt-0.5 text-[11.5px] leading-relaxed italic text-ink-mute">
      Some lines triggered more than one check.
    </p>
    <div class="mt-2.5 grid gap-2">
      {
        reasons.map((reason) => (
          <div class="grid grid-cols-[7.25rem_minmax(0,1fr)_2rem] items-center gap-2.5">
            <p class="text-[12px] leading-snug text-ink-soft">{reason.label}</p>
            <div class="h-[8px]">
              <div
                class="h-[8px] rounded-sm bg-slate"
                style={`width:${(reason.count / maxReasonCount) * 100}%`}
              />
            </div>
            <p class="text-right text-[12px] font-medium tabular-nums text-ink">{reason.count}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>
