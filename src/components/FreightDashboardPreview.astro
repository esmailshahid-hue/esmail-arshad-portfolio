---
/**
 * Homepage preview body for the freight card. Vendor names and spend figures
 * are read directly from the real sanitized dashboard (freight-dashboard.png)
 * — vendor identity here is not confidential, only the client's is. Bar widths
 * are computed from the real spend figures, not laid in by hand.
 */
const vendors = [
  { name: 'FedEx', spend: 118589, share: '17.1%' },
  { name: 'DHL Express', spend: 103308, share: '14.9%' },
  { name: 'XPO Logistics', spend: 97353, share: '14.0%' },
  { name: 'J.B. Hunt', spend: 95339, share: '13.7%' },
  { name: 'UPS', spend: 76320, share: '11.0%' },
] as const;

const top = vendors[0].spend;
const fmt = (n: number) => `$${(n / 1000).toFixed(1)}K`;
---

<div class="grid gap-3.5">
  <div class="grid gap-2">
    {
      vendors.map((v, i) => (
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)_5rem] items-center gap-2.5">
          <p class="truncate text-[12px] text-ink-soft">{v.name}</p>
          <div class="h-[9px] rounded-sm bg-rule-soft">
            <div
              class="h-[9px] rounded-sm bg-slate"
              style={`width:${(v.spend / top) * 100}%; opacity:${1 - i * 0.13}`}
            />
          </div>
          <p class="text-right text-[12px] font-medium text-ink">
            {fmt(v.spend)} <span class="text-[10.5px] font-normal text-ink-mute">{v.share}</span>
          </p>
        </div>
      ))
    }
  </div>

  <div class="grid gap-0.5 border-t border-rule-soft pt-3">
    <p class="text-[11.5px] text-ink-soft">Top 3 vendors = 45.9% of spend</p>
    <p class="text-[11px] text-ink-mute">60 invoice lines flagged for review</p>
  </div>
</div>
