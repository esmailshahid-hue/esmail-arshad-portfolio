---
import Tag from './Tag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;

// A card must communicate without a click (§10). Unpublished drafts still show
// problem, organization, tags and an outcome signal — they simply do not link.
const linked = d.published;
const href = `/work/${entry.id}/`;

const Wrapper = linked ? 'a' : 'div';
const wrapperProps = linked ? { href } : {};

const kindNote =
  d.type === 'client-project' ? d.organization : `${d.organization} · ${d.displayTitle}`;
---

<Wrapper
  {...wrapperProps}
  class={`group relative flex h-full flex-col gap-5 border-t border-rule pt-6 no-underline ${
    linked ? 'transition-colors hover:border-slate' : ''
  }`}
>
  <div>
    <p class="eyebrow mb-3">{kindNote}</p>
    <h3
      class={`font-display text-2xl leading-tight text-ink ${
        linked ? 'transition-colors group-hover:text-slate' : ''
      }`}
    >
      {d.title}
    </h3>
    <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">{d.summary}</p>
  </div>

  <div class="mt-auto flex flex-col gap-5">
    <div class="border-t-2 border-slate pt-3">
      <p class="font-display text-2xl font-semibold leading-none text-ink">
        {d.headlineOutcome.value}
      </p>
      <p class="mt-1.5 text-sm text-ink-soft">{d.headlineOutcome.label}</p>
    </div>

    {
      d.scope.length > 0 && (
        <p class="text-xs leading-relaxed text-ink-mute">{d.scope.join(' · ')}</p>
      )
    }

    <ul class="flex list-none flex-wrap gap-2">
      {d.capabilities.map((c) => (
        <li>
          <Tag label={c} />
        </li>
      ))}
    </ul>

    {linked && (
      <p class="text-sm font-medium text-slate">
        Read the case study <span aria-hidden="true">→</span>
      </p>
    )}
  </div>
</Wrapper>
