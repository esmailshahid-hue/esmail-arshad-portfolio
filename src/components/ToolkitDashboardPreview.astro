---
/**
 * Homepage preview for the Supply Chain Workbench.
 *
 * A workflow rather than a feature list: the earlier version was three text
 * columns and a flow line underneath, which showed what the toolkit contains
 * but not how it is used. This traces one file through the product — in, mapped,
 * down one of three paths, out — so the shape of the tool is legible before the
 * reader opens it.
 *
 * Native type and rules, no imported diagram library: it inherits the page's
 * fonts and both themes, and stays selectable and translatable.
 *
 * Carries no figures. The toolkit runs on whatever CSV is loaded, so any number
 * here would be invented.
 */
const workflows = [
  { name: 'Inventory Planner', result: 'Reorder quantities' },
  { name: 'Freight Exceptions', result: 'Cost & late flags' },
  { name: 'Supplier Scorecard', result: 'Performance score' },
] as const;
---

<div class="wf">
  {/* ---------------------------------------------------------------- Input */}
  <p class="step">CSV upload</p>
  <span class="drop" aria-hidden="true"></span>
  <p class="step">Map fields</p>

  {/* --------------------------------------------------- Choose one workflow */}
  <p class="choose">Choose workflow</p>
  <span class="branch" aria-hidden="true"></span>

  <ul class="paths">
    {
      workflows.map((w) => (
        <li class="path">
          <span class="tick" aria-hidden="true"></span>
          <p class="name">{w.name}</p>
          <p class="result">{w.result}</p>
        </li>
      ))
    }
  </ul>

  {/* --------------------------------------------------------------- Output */}
  <span class="merge" aria-hidden="true"></span>
  <p class="step">Calculated results</p>

  <span class="drop" aria-hidden="true"></span>

  <div class="out">
    <p class="primary">Export CSV</p>
    <p class="secondary">Action Summary</p>
  </div>
</div>

<style>
  /* One centred column. Every rule is a 1px border in the page's own token, so
     the diagram picks up both themes without a second definition. */
  .wf {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .step {
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  /* The vertical connector between stages. */
  .drop {
    width: 1px;
    height: 14px;
    background: var(--color-rule);
    margin: 5px 0;
  }

  /* The connector under the results line is shorter — the outputs belong to
     that step rather than forming a new stage. */
  .step + .drop {
    height: 11px;
    margin: 4px 0 0;
  }

  .choose {
    margin-top: 9px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  /* The split: one line down from "Choose workflow", then a horizontal rule
     across the row. Each path drops its own tick from that rule, so the three
     branches are drawn rather than implied. Deliberately the mirror image of
     `.merge` below, which closes the branch the same way. */
  .branch {
    width: 100%;
    height: 1px;
    background: var(--color-rule);
    margin-top: 18px;
    position: relative;
  }
  .branch::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 12px;
    background: var(--color-rule);
  }

  .paths {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 0.75rem;
    width: 100%;
    margin-top: 0;
    padding: 0;
  }

  .path {
    display: grid;
    justify-items: center;
    min-width: 0;
  }

  /* Masks the branch rule outside the first and last drop, so it terminates at
     the outer branches instead of running to the card edge. */
  .paths::before,
  .paths::after {
    content: "";
    position: absolute;
    top: -1px;
    width: calc((100% - 1.5rem) / 6);
    height: 1px;
    background: var(--color-card);
  }
  .paths::before { left: 0; }
  .paths::after { right: 0; }

  /* The drop from the branch rule into each workflow. */
  .tick {
    width: 1px;
    height: 12px;
    background: var(--color-rule);
  }

  .name {
    margin-top: 7px;
    padding-top: 7px;
    border-top: 1px solid var(--color-slate);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .result {
    margin-top: 2px;
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--color-ink-mute);
  }

  /* The three paths rejoin: a full-width rule, then one line down, mirroring
     the tick-and-rule that opened the branch. */
  .merge {
    width: 100%;
    height: 1px;
    background: var(--color-rule);
    margin: 11px 0 0;
    position: relative;
  }
  .merge::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 12px;
    background: var(--color-rule);
  }

  /* Clears the merge connector that drops from the rule above. */
  .merge + .step {
    margin-top: 16px;
  }

  .step + .out,
  .out {
    margin-top: 7px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem 1.1rem;
  }

  /* Export is the deterministic output and reads first; the summary is
     user-triggered and sits quieter, which is also the order they occur in
     the product. */
  .primary {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .secondary {
    font-size: 11.5px;
    color: var(--color-ink-mute);
  }

  /* On a narrow card three columns would set 11px type on two-word labels.
     The branch becomes a stack, each path keeping its slate rule. */
  @container (max-width: 22rem) {
    /* Stacked, a horizontal three-way rule has nothing to span: the flow runs
       straight down instead, one drop between each workflow. */
    .branch {
      width: 1px;
      margin-top: 9px;
      height: 12px;
    }
    .branch::before {
      display: none;
    }
    .paths {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      max-width: 15rem;
    }
    .paths::before,
    .paths::after {
      display: none;
    }
    .path:first-child .tick {
      height: 0;
    }
    .path:not(:first-child) .tick {
      height: 9px;
    }
    .name {
      margin-top: 5px;
      padding-top: 5px;
    }
  }
</style>
