---
/**
 * A plain inputs → output → result line for employer case studies, which carry
 * no screenshots. Explanatory only — deliberately typographic, never styled to
 * resemble a reproduction of an internal system (§23).
 */
interface Props {
  inputs: readonly string[];
  output: string;
  result: string;
}
const { inputs, output, result } = Astro.props;
---

<div class="border-y border-rule py-5">
  <ol class="flex list-none flex-wrap items-baseline gap-x-3 gap-y-2 text-sm">
    {
      inputs.map((input, i) => (
        <li class="flex items-baseline gap-3">
          {i > 0 && <span aria-hidden="true" class="text-ink-mute">+</span>}
          <span class="text-ink-soft">{input}</span>
        </li>
      ))
    }
    <li class="flex items-baseline gap-3">
      <span aria-hidden="true" class="text-slate">→</span>
      <span class="font-medium text-ink">{output}</span>
    </li>
    <li class="flex items-baseline gap-3">
      <span aria-hidden="true" class="text-slate">→</span>
      <span class="text-ink-soft">{result}</span>
    </li>
  </ol>
</div>
