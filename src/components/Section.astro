---
interface Props {
  id?: string;
  /** Rendered as the section heading. Omit for sections that need no label. */
  heading?: string;
  /** Hairline rule above the section. Off by default — vary the rhythm. */
  divided?: boolean;
  /** 'tight' for dense lists, 'default' for editorial content. */
  density?: 'tight' | 'default';
  class?: string;
}
const {
  id,
  heading,
  divided = false,
  density = 'default',
  class: cls = '',
} = Astro.props;

const pad = density === 'tight' ? 'py-10 md:py-12' : 'py-12 md:py-16';
---

<section id={id} class={`${divided ? 'border-t border-rule-soft' : ''} ${pad} ${cls}`}>
  <div class="shell">
    {
      heading && (
        <h2 class="mb-6 font-display text-section text-ink md:mb-8">{heading}</h2>
      )
    }
    <slot />
  </div>
</section>
