---
import type { CollectionEntry } from 'astro:content';
import CardPreview from './CardPreview.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  /** The lead card spans two columns, so its title can carry more weight. */
  lead?: boolean;
  /** Archive listing: denser, no preview graphic. */
  compact?: boolean;
}
const { entry, lead = false, compact = false } = Astro.props;
const d = entry.data;
const titleBreak = d.title.lastIndexOf(' ');
const titleLead = titleBreak > 0 ? d.title.slice(0, titleBreak) : '';
const titleEnd = titleBreak > 0 ? d.title.slice(titleBreak + 1) : d.title;
---

{/* Company, title, one result. The role-focus line was removed: on a page of
    cards it became a third block of grey text and said what the title already
    implies. It still opens every case-study page. */}
<a
  href={`/work/${entry.id}/`}
  class="group flex h-full flex-col border-t border-rule pt-5 no-underline transition-colors hover:border-slate"
>
  <p class="text-sm font-medium text-ink">{d.organization}</p>

  <h3
    class:list={[
      'mt-2 font-display leading-snug text-ink transition-colors group-hover:text-slate',
      lead ? 'text-2xl md:text-[2rem]' : compact ? 'text-lg' : 'text-xl',
    ]}
  >
    {titleLead && <>{titleLead}{' '}</>}
    <span class="whitespace-nowrap">
      {titleEnd}{' '}<span
        aria-hidden="true"
        class="inline-block text-[0.85em] text-slate transition-transform group-hover:translate-x-0.5"
      >
        →
      </span>
    </span>
  </h3>

  {
    !compact && d.preview && (
      <div class="mt-5">
        <CardPreview preview={d.preview} />
      </div>
    )
  }

  <p class="mt-5 flex items-baseline gap-2 text-base">
    <span class="shrink-0 font-display text-lg font-semibold text-ink">
      {d.headlineOutcome.value}
    </span>
    <span class="text-ink-soft">{d.headlineOutcome.label}</span>
  </p>
</a>
