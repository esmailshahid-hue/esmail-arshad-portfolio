---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const d = entry.data;
---

<a
  href={`/work/${entry.id}/`}
  class="group flex h-full flex-col border-t border-rule pt-5 no-underline transition-colors hover:border-slate"
>
  <p class="text-sm font-medium text-ink">{d.organization}</p>

  <h3
    class="mt-2 font-display text-xl leading-snug text-ink transition-colors group-hover:text-slate"
  >
    {d.title}
  </h3>

  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{d.roleFocus}</p>

  <p class="mt-5 flex items-baseline gap-2 text-base">
    <span class="font-display text-lg font-semibold text-ink">
      {d.headlineOutcome.value}
    </span>
    <span class="text-ink-soft">{d.headlineOutcome.label}</span>
    <span aria-hidden="true" class="text-slate transition-transform group-hover:translate-x-0.5">
      →
    </span>
  </p>
</a>
