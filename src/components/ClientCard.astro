---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  thumb?: ImageMetadata;
  compact?: boolean;
}
const { entry, thumb, compact = false } = Astro.props;
const d = entry.data;

// A whole dashboard scaled to card width is an unreadable block of blue. The
// crop zooms into the part worth seeing; the full sanitized sheet is on the page.
const primary = d.images.find((i) => i.primary) ?? d.images[0];
const crop = primary?.thumb;
---

<a
  href={`/work/${entry.id}/`}
  class="group flex h-full flex-col border-t border-rule pt-5 no-underline transition-colors hover:border-slate"
>
  {
    thumb && !compact && (
      <div
        class="relative mb-5 aspect-[16/10] overflow-hidden border border-rule bg-white"
        aria-hidden="true"
      >
        <Image
          src={thumb}
          alt=""
          widths={[700, 1100, 1600]}
          sizes="(min-width: 768px) 45vw, 92vw"
          class="absolute max-w-none transition-transform duration-300 group-hover:scale-[1.02]"
          style={`width:${(crop?.zoom ?? 1) * 100}%; left:${-(crop?.x ?? 0)}%; top:${-(crop?.y ?? 0)}%`}
          loading="lazy"
        />
      </div>
    )
  }

  <p class="text-sm font-medium text-ink">{d.roleFocus}</p>

  <h3
    class:list={[
      'mt-2 font-display leading-snug text-ink transition-colors group-hover:text-slate',
      compact ? 'text-lg' : 'text-xl',
    ]}
  >
    {d.title}{' '}
    <span
      aria-hidden="true"
      class="inline-block text-[0.85em] text-slate transition-transform group-hover:translate-x-0.5"
    >
      →
    </span>
  </h3>

  <p class="mt-5 flex items-baseline gap-2 text-base">
    <span class="shrink-0 font-display text-lg font-semibold text-ink">
      {d.headlineOutcome.value}
    </span>
    <span class="text-ink-soft">{d.headlineOutcome.label}</span>
  </p>
</a>
