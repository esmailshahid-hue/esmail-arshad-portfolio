---
/**
 * Homepage card for the two independent client projects.
 *
 * Order matters here: category, then title, then what was built, and only then
 * the evidence. The previous version led with the KPI strip, so the reader met
 * "$695K / 421 / 60" before knowing what the project was.
 *
 * `built` states the deliverable; `methods` names the tools and disciplines as
 * a quiet inline list rather than chips, matching the Core/Systems convention
 * in the hero. Neither repeats the KPI values.
 *
 * The bespoke visual arrives via the default slot — the two dashboards don't
 * share a shape worth abstracting over just two cases. Every number in a
 * slotted body traces to the real workbook; see the `evidence` block on the
 * corresponding case-study page.
 */
interface Kpi {
  value: string;
  label: string;
}
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  built: string;
  kpis: readonly Kpi[];
  methods: readonly string[];
}
const { href, eyebrow, title, built, kpis, methods } = Astro.props;
---

<a href={href} class="group flex h-full flex-col no-underline">
  <p class="text-xs font-semibold tracking-wide text-ink-mute uppercase">{eyebrow}</p>

  {/* Fixed block so both previews start at the same y side by side. Measured:
      at 1024 the first title wraps to two lines and the second does not, so
      without this they misalign by 28px. Tighter at xl, where both fit one line. */}
  <div class="mt-2.5 lg:min-h-[7.5rem] xl:min-h-[6rem]">
    <h3 class="font-display text-xl leading-snug text-ink transition-colors group-hover:text-slate">
      {title} <span aria-hidden="true" class="text-slate">→</span>
    </h3>
    <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{built}</p>
  </div>

  <div
    class="mt-4 flex flex-1 flex-col justify-between gap-4 border border-rule bg-card p-5 transition-colors group-hover:border-ink-mute"
    style="container-type:inline-size"
  >
    <dl class="grid grid-cols-4 gap-x-2.5 gap-y-3.5">
      {
        kpis.map((kpi) => (
          <div class="min-w-0">
            <dt class="sr-only">{kpi.label}</dt>
            <dd
              class="font-display font-semibold text-ink"
              style="font-size:clamp(1.0625rem,6cqw,1.5625rem);line-height:1"
            >
              {kpi.value}
            </dd>
            <p class="mt-0.5 text-[11px] font-semibold tracking-wide text-ink-mute uppercase">
              {kpi.label}
            </p>
          </div>
        ))
      }
    </dl>

    <slot />
  </div>

  <p class="mt-3 text-[13px] text-ink-mute">{methods.join(' · ')}</p>
</a>
