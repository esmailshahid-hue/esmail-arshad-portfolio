---
/**
 * Homepage card for the two independent client projects. Chrome (border, KPI
 * strip, title, subtitle) is shared; the middle visual is bespoke per project
 * — a small SKU table for the inventory model, a vendor-spend bar chart for
 * freight — passed in via the default slot, since the two dashboards don't
 * share a shape worth abstracting over just two cases.
 *
 * Every number in a slotted body must trace to the real workbook. See the
 * `evidence` block on the corresponding case-study page for sourcing.
 */
interface Kpi {
  value: string;
  label: string;
}
interface Props {
  href: string;
  eyebrow: string;
  kpis: readonly Kpi[];
  title: string;
  subtitle: string;
}
const { href, eyebrow, kpis, title, subtitle } = Astro.props;
---

<a href={href} class="group flex h-full flex-col no-underline">
  <p class="mb-2.5 text-xs font-semibold tracking-wide text-ink-mute uppercase">{eyebrow}</p>

  <div
    class="flex flex-1 flex-col justify-between gap-4 border border-rule bg-card p-5 transition-colors group-hover:border-ink-mute"
    style="container-type:inline-size"
  >
    <dl class="grid grid-cols-4 gap-x-2.5 gap-y-3.5">
      {
        kpis.map((kpi) => (
          <div class="min-w-0">
            <dt class="sr-only">{kpi.label}</dt>
            <dd
              class="font-display font-semibold text-ink"
              style="font-size:clamp(1.0625rem,6cqw,1.5625rem);line-height:1"
            >
              {kpi.value}
            </dd>
            <p class="mt-0.5 text-[10px] font-semibold tracking-wide text-ink-mute uppercase">
              {kpi.label}
            </p>
          </div>
        ))
      }
    </dl>

    <slot />
  </div>

  <h3 class="mt-3.5 min-h-[2.4em] font-display text-xl leading-snug text-ink transition-colors group-hover:text-slate">
    {title} <span aria-hidden="true" class="text-slate">→</span>
  </h3>
  <p class="mt-1.5 text-sm text-ink-mute">{subtitle}</p>
</a>
