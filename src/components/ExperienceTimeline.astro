---
/** Editorial career history: compact chronology, broad role scope, quiet evidence. */
import { experience } from '@content/site';
---

<ol class="-mt-3 grid list-none gap-0">
  {
    experience.map((role) => (
      <li class="border-t border-rule-soft first:border-t-0">
        <div class="grid gap-x-6 py-5 sm:grid-cols-[minmax(8.5rem,20%)_minmax(0,1fr)] md:gap-x-8">
          <div class="sm:pt-1">
            <p class="text-[13px] font-medium leading-snug text-ink-soft">{role.dates}</p>
            <p class="mt-1 text-[12px] leading-snug text-ink-soft">{role.location}</p>
          </div>

          <div class="mt-3 min-w-0 sm:mt-0">
            <h3 class="font-display text-xl leading-tight text-ink">{role.displayTitle}</h3>
            <p class="mt-1 text-[12px] font-semibold text-slate uppercase">
              <a
                href={`/work/${role.slug}/`}
                class="inline-flex items-center gap-1 text-slate no-underline underline-offset-4 transition-colors hover:text-slate-deep hover:underline"
              >
                {role.company}
                <span aria-hidden="true">→</span>
              </a>
            </p>

            <p class="mt-2.5 max-w-[54rem] text-[15px] leading-relaxed text-ink-soft">
              {role.scope}
            </p>

            <ul class="mt-3 flex list-none flex-wrap gap-1.5">
              {
                role.metrics.map((metric) => (
                  <li class="rounded-[8px] bg-paper-deep px-2.5 py-1 text-[12px] leading-snug font-medium text-ink-soft">
                    {metric}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </li>
    ))
  }
</ol>
