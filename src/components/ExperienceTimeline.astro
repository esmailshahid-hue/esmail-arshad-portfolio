---
/**
 * Career list. Replaces the horizontal proportional band, which capped each
 * annotation at 8.5rem — too narrow to say what the role actually involved, and
 * only ever rendered at 1280px and above. Exact month ranges carry the
 * chronology, which Pass 1 already treated as authoritative with the bar as a
 * supporting cue.
 *
 * Deliberately quiet: hairline separators, no rail, no dots, no chips. The one
 * metric per role uses the same value/label pairing the work cards already use
 * elsewhere on the site, so a result reads as a result without a container
 * around it.
 *
 * Tools live inside the scope sentence rather than in a separate tag row — see
 * content/site.ts.
 */
import { experience } from '@content/site';
---

<ol class="grid list-none gap-0">
  {
    experience.map((role) => (
      <li class="border-t border-rule-soft first:border-t-0">
        <div class="grid gap-x-10 py-6 sm:grid-cols-[9.5rem_1fr] sm:py-7">
          <p class="text-[13px] leading-relaxed text-ink-mute sm:mt-1">{role.dates}</p>

          <div class="mt-1.5 min-w-0 sm:mt-0">
            <h3 class="font-display text-[19px] leading-tight text-ink">
              <a
                href={`/work/${role.slug}/`}
                class="text-ink underline decoration-rule underline-offset-[5px] transition-colors hover:text-slate hover:decoration-slate"
              >
                {role.company}
              </a>
            </h3>
            <p class="mt-1 text-[14px] leading-snug text-ink-soft">{role.displayTitle}</p>

            <p class="measure mt-3 text-[15px] leading-relaxed text-ink-soft">{role.scope}</p>

            <p class="mt-2 text-[15px]">
              <span class="font-display font-semibold text-ink">{role.metric.value}</span>{' '}
              <span class="text-ink-mute">{role.metric.label}</span>
            </p>
          </div>
        </div>
      </li>
    ))
  }
</ol>
