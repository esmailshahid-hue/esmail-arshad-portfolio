---
interface Props {
  value: string;
  label: string;
  /** Outcome, scope and finding are treated visually as distinct (§16). */
  kind?: 'outcome' | 'scope' | 'finding';
  size?: 'sm' | 'md' | 'lg';
}
const { value, label, kind = 'outcome', size = 'md' } = Astro.props;

const valueSize = {
  sm: 'text-2xl md:text-3xl',
  md: 'text-3xl md:text-4xl',
  lg: 'text-4xl md:text-5xl',
}[size];

// Outcome carries the accent rule; scope and finding are deliberately quieter.
const rule = {
  outcome: 'border-slate',
  scope: 'border-rule',
  finding: 'border-ink-mute',
}[kind];

const valueTone = kind === 'scope' ? 'text-ink-soft' : 'text-ink';

const kindLabel = { outcome: null, scope: 'Scope', finding: 'Finding' }[kind];
---

<div class={`border-t-2 ${rule} pt-3`}>
  {
    kindLabel && (
      <p class="eyebrow mb-1.5 text-[0.625rem]">{kindLabel}</p>
    )
  }
  <p class={`font-display font-semibold leading-none ${valueSize} ${valueTone}`}>
    {value}
  </p>
  <p class="mt-2 text-sm leading-snug text-ink-soft">{label}</p>
</div>
